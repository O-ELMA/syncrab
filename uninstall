#!/bin/sh

# Logging ─────────────────────────────────────────────────────────────────────
log() {
    printf '\033[1;36m💡 [INFO]\033[0m %s\n' "$1"
}
success() {
    printf '\033[1;32m✅ [SUCCESS]\033[0m %s\n' "$1"
}
warning() {
    printf '\033[1;33m⚠️  [WARNING]\033[0m %s\n' "$1"
}
line() {
    printf '────────────────────────────────────────────────────────────────────────\n'
}

# Init logic ──────────────────────────────────────────────────────────────────
line
set -u

PREFIX="${PREFIX:-$HOME/.local/bin}"
LEGACY_PREFIX="$HOME/.cargo/bin"

if [ "$(uname -s)" = Darwin ]; then
    data_dir="$HOME/Library/Application Support/syncrab"
else
    data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/syncrab"
fi

# Binaries ────────────────────────────────────────────────────────────────────
log "Removing binaries..."

removed=0
for prefix in "$PREFIX" "$LEGACY_PREFIX"; do
    for bin in syncrab syncrab_b syncrab_w; do
        if [ -e "$prefix/$bin" ]; then
            rm -f "$prefix/$bin"
            log "Removed $prefix/$bin"
            removed=$((removed + 1))
        fi
    done
done

[ "$removed" -eq 0 ] && warning "No syncrab binaries found in $PREFIX or $LEGACY_PREFIX."
line

# Background jobs ─────────────────────────────────────────────────────────────
service_file="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/syncrab_w.service"

if [ -f "$service_file" ]; then
    log "Removing the systemd service..."
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user disable --now syncrab_w.service 2>/dev/null || warning "Service not active."
        systemctl --user daemon-reload 2>/dev/null || true
    fi
    rm -f "$service_file"
fi

for label in watcher backup; do
    plist="$HOME/Library/LaunchAgents/com.syncrab.$label.plist"
    if [ -f "$plist" ]; then
        launchctl unload "$plist" 2>/dev/null || true
        rm -f "$plist"
        log "Removed $plist"
    fi
done

if command -v crontab >/dev/null 2>&1; then
    log "Removing the cron job..."
    cron_tmp=$(mktemp)
    crontab -l 2>/dev/null | grep -v syncrab_b > "$cron_tmp" || true
    crontab "$cron_tmp"
    rm -f "$cron_tmp"
fi
line

# Database ────────────────────────────────────────────────────────────────────
for db in "$data_dir/syncrab.db" "$PREFIX/syncrab.db" "$LEGACY_PREFIX/syncrab.db"; do
    if [ -f "$db" ]; then
        log "Deleting $db..."
        rm -f "$db"
    fi
done
line

success "Uninstallation complete."
